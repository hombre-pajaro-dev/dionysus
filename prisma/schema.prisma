generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum MembershipStatus {
  PENDING   // Solicitud enviada, esperando aprobación (solo venues privados)
  ACTIVE    // Membresía activa
  SUSPENDED // Dado de baja por organizador
}

enum RoleType {
  ADMIN         // Admin global de la plataforma
  ORGANIZER     // Gestiona venue, eventos y aprobaciones de membresía
  DOOR_OPERATOR // Verifica acceso en la puerta + puede aprobar membresías en vivo
  TOKEN_CASHIER // Agrega tokens via efectivo
}

enum TransactionType {
  DONATION  // Donativo digital (Stripe)
  TOPUP     // Carga manual por Cajero de Tokens
  POS_DEBIT // Descuento por compra en POS (sistema externo via API)
  REVERSAL  // Reversión de una transacción anterior
}

enum EventVisibility {
  MEMBERS_ONLY // Solo visible para miembros activos del venue
  PUBLIC       // Visible sin autenticación; participar igual requiere membresía
}

enum VenueVisibility {
  PUBLIC  // Membresía auto-activa en primera compra
  PRIVATE // Solo por liga de invitación; requiere aprobación manual
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

// ─── User ─────────────────────────────────────────────────────────────────────
// Identidad global en la plataforma. Un usuario puede pertenecer a múltiples venues.

model User {
  id          String   @id @default(cuid())
  phone       String   @unique // Identificador primario — número WhatsApp
  name        String
  city        String?
  artPractice String?  // Qué arte practica (global; alimentará ArtistProfile futuro)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships    Membership[] @relation("UserMemberships")
  referredOthers Membership[] @relation("MembershipReferral")
  roles          UserRole[]
  inviteLinks    InviteLink[]
  otpCodes       OtpCode[]
  payments       Payment[]
}

// ─── Venue ────────────────────────────────────────────────────────────────────
// Espacio físico y comunidad. Tiene sus propios miembros, eventos y tokens.

model Venue {
  id          String          @id @default(cuid())
  name        String
  description String?
  manifesto   String?         // Valores y compromisos de esta comunidad
  slug        String          @unique
  visibility  VenueVisibility @default(PRIVATE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  events      Event[]
  memberships Membership[]
  roles       UserRole[]
  inviteLinks InviteLink[]
}

// ─── Membership ───────────────────────────────────────────────────────────────
// Relación entre Usuario y Venue. El Balance de tokens vive aquí — no en User.

model Membership {
  id                  String           @id @default(cuid())
  userId              String
  venueId             String
  status              MembershipStatus @default(PENDING)
  howHeard            String?          // Cómo se enteró de este venue específico
  whyJoin             String?          // Por qué quiere ser parte de este venue
  manifestoAcceptedAt DateTime?        // Aceptación del manifiesto de este venue
  referrerId          String?          // userId del miembro que invitó a este venue
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  user         User            @relation("UserMemberships", fields: [userId], references: [id])
  venue        Venue           @relation(fields: [venueId], references: [id])
  referrer     User?           @relation("MembershipReferral", fields: [referrerId], references: [id])
  transactions Transaction[]
  accesses     EventAccess[]
  linkUses     InviteLinkUse[]
  payments     Payment[]

  @@unique([userId, venueId])
}

// ─── Auth ─────────────────────────────────────────────────────────────────────

model OtpCode {
  id        String    @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User? @relation(fields: [phone], references: [phone])

  @@index([phone])
}

// ─── Invite Links ─────────────────────────────────────────────────────────────
// Scoped a un venue. maxUses: null = ilimitado, 1 = uso único (default El Nido).

model InviteLink {
  id            String   @id @default(cuid())
  token         String   @unique @default(cuid())
  venueId       String
  generatedById String   // userId
  maxUses       Int?     // null = ilimitado
  createdAt     DateTime @default(now())

  venue       Venue           @relation(fields: [venueId], references: [id])
  generatedBy User            @relation(fields: [generatedById], references: [id])
  uses        InviteLinkUse[]
}

model InviteLinkUse {
  id           String   @id @default(cuid())
  inviteLinkId String
  membershipId String
  usedAt       DateTime @default(now())

  inviteLink InviteLink @relation(fields: [inviteLinkId], references: [id])
  membership Membership @relation(fields: [membershipId], references: [id])

  @@unique([inviteLinkId, membershipId])
}

// ─── Roles ────────────────────────────────────────────────────────────────────
// Control de acceso. Ortogonal a Membresía y a ArtistProfile (futuro).

model UserRole {
  id           String   @id @default(cuid())
  userId       String
  role         RoleType
  venueId      String?  // null = rol global (solo ADMIN)
  assignedById String?
  assignedAt   DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id])
  venue Venue? @relation(fields: [venueId], references: [id])

  @@unique([userId, role, venueId])
}

// ─── Events ───────────────────────────────────────────────────────────────────

model Event {
  id              String          @id @default(cuid())
  venueId         String
  name            String
  description     String?
  date            DateTime
  durationMinutes Int             @default(180)
  minimumDonation Int             // En centavos MXN
  visibility      EventVisibility @default(MEMBERS_ONLY)
  createdById     String          // userId
  cancelledAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  venue    Venue         @relation(fields: [venueId], references: [id])
  accesses EventAccess[]
  payments Payment[]
}

// ─── Event Access ─────────────────────────────────────────────────────────────

model EventAccess {
  id           String   @id @default(cuid())
  membershipId String
  eventId      String
  paymentId    String?  // null si fue otorgado manualmente por Cajero de Tokens
  grantedAt    DateTime @default(now())

  membership Membership @relation(fields: [membershipId], references: [id])
  event      Event      @relation(fields: [eventId], references: [id])

  @@unique([membershipId, eventId])
}

// ─── Payments ─────────────────────────────────────────────────────────────────

model Payment {
  id                String        @id @default(cuid())
  userId            String
  membershipId      String        // qué balance recibe el crédito
  eventId           String?
  amountCents       Int           // Monto en centavos MXN
  provider          String        // "stripe" | "mercadopago" | etc.
  providerPaymentId String?       @unique
  status            PaymentStatus @default(PENDING)
  method            String?       // "card" | "oxxo"
  confirmedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user       User       @relation(fields: [userId], references: [id])
  membership Membership @relation(fields: [membershipId], references: [id])
  event      Event?     @relation(fields: [eventId], references: [id])
}

// ─── Balance / Transactions ───────────────────────────────────────────────────
// Ledger inmutable. Balance = SUM(amountCents) WHERE membershipId = X.
// Tokens son venue-scoped via Membresía — no globales.

model Transaction {
  id                String          @id @default(cuid())
  membershipId      String          // venue-scoped via Membership
  type              TransactionType
  amountCents       Int             // Positivo = crédito, negativo = débito
  concept           String          // Descripción legible
  externalReference String?         // ID de pago en Stripe, ID de venta en POS, etc.
  reversalOfId      String?         // Para reversiones, ID de la transacción original
  createdAt         DateTime        @default(now())

  membership Membership @relation(fields: [membershipId], references: [id])

  @@index([membershipId, createdAt])
}
